+thread_local! {
+    /// The checkedness that has left the `checked` attribute (a click, a
+    /// script), by raw NodeId, for the earlier siblings of an ANCESTOR that
+    /// the selector walk reads from the DOM (`dom_earlier_siblings`). The
+    /// subject's own siblings come with their live state from the build.
+    static WALK_CHECKED: std::cell::RefCell<HashMap<usize, bool>> = std::cell::RefCell::new(HashMap::new());
+}
+
+/// Sets [`WALK_CHECKED`] for its lifetime and puts the previous map back:
+/// around a view's build (its `checked_states`) and a script query.
+pub(crate) struct WalkCheckedScope(HashMap<usize, bool>);
+
+impl WalkCheckedScope {
+    pub(crate) fn enter(checked: HashMap<usize, bool>) -> Self {
+        WalkCheckedScope(WALK_CHECKED.with(|c| c.replace(checked)))
+    }
+}
+
+impl Drop for WalkCheckedScope {
+    fn drop(&mut self) {
+        let previous = std::mem::take(&mut self.0);
+        WALK_CHECKED.with(|c| *c.borrow_mut() = previous);
+    }
+}
+
+/// The element children of `node`'s parent before it, as `+` / `~` see
+/// them, with the nodes: what the walk tests once a descendant or child
+/// step has moved it up to an ancestor (`.ctrl:checked + .icon .off`).
+/// Selectors read the DOM tree, so a host's light children are siblings
+/// as they stand in it. Empty when `node` has no parent.
+fn dom_earlier_siblings(node: &Rc<Node>) -> Vec<(SiblingKey, Rc<Node>)> {
+    let Some(parent) = node.parent() else {
+        return Vec::new();
+    };
+    let mut out = Vec::new();
+    for c in parent.children() {
+        if Rc::ptr_eq(&c, node) {
+            return out;
+        }
+        let NodeType::Element { tag_name, attributes, .. } = &c.node_type else {
+            continue;
+        };
+        let tag = lower_tag(tag_name).into_owned();
+        let live = WALK_CHECKED.with(|m| m.borrow().get(&c.id.raw()).copied());
+        let state = match live {
+            Some(on) if tag == "input" && on != attributes.contains_key("checked") => {
+                let mut attributes = attributes.clone();
+                if on {
+                    attributes.insert("checked".to_string(), String::new());
+                } else {
+                    attributes.remove("checked");
+                }
+                ElementState::of(&tag, &attributes)
+            }
+            _ => ElementState::of(&tag, attributes),
+        };
+        let key = (tag, element_classes(attributes), attributes.get("id").cloned(), state);
+        out.push((key, c.clone()));
+    }
+    Vec::new()
+}
