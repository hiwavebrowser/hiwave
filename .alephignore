# Trench night-2 (Atlas, 2026-07-08): port of Athena's vendor-mask approach
# (hiwave-windows@b692647 — her deps/ tree evaded aleph's default skip list).
# Entries are directory NAMES matched at any depth (aleph 0.5.0,
# project/discovery.py effective_skip_dirs). vendor/ and target/ are already
# in the default mask — do not repeat them here.

# Vendored cairo fork: 4,814 symbols per copy, indexed twice via
# hiwave-windows/deps and hiwave-linux/deps = 7.3% of the workspace index.
deps

# Capture/baseline/golden trees: binary + generated test-page churn.
# Masking keeps symbol search clean and bounds the temporal git-log scan
# (unscoped, per-commit numstat over PNG churn is effectively unbounded).
.browsers
parity-baseline
parity-history
multisurface-captures
builtins-captures
builtins-baselines
builtins-diffs
baselines
goldens
websuite

# Session-7/8 (Atlas, 2026-07-09): the HUB index walks into submodules and the
# submodule .alephignore is NOT honored at hub level. Mask the wrong-engine and
# sibling-platform trees so hub aleph_search resolves to the metric engine
# (hiwave-macos/crates/rustkit-*) instead of returning fastrender + linux +
# windows copies of every symbol (session-7 ledger item d).
fastrender
hiwave-linux
hiwave-windows

# Session-8 ledger d: hub search surfaced hiwave-web JSX despite sibling mask
hiwave-web
